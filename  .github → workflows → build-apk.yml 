name: Build APK

on:
  workflow_dispatch:
  push:
    branches: [main]

jobs:
  build:
    runs-on: ubuntu-latest

    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Set up Java 17
        uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: '17'
          cache: gradle

      - name: Unzip Android project
        run: |
          rm -rf project
          mkdir -p project
          unzip -q Gen-Android-Project.zip -d project

      - name: Build Debug APK
        working-directory: project/Gen
        run: |
          chmod +x gradlew
          ./gradlew assembleDebug --stacktrace

      - name: Upload APK
        uses: actions/upload-artifact@v4
        with:
          name: app-debug
          path: project/Gen/app/build/outputs/apk/debug/app-debug.apk
          if-no-files-found: error
          retention-days: 30